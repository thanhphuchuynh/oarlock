{
  "$comment": [
    "The single source for every colour in the product (UX spec § Design System).",
    "The rule this file exists to enforce: a colour is never written twice. The",
    "component ships CSS custom properties and the console uses Tailwind, and two",
    "hand-maintained palettes drift — so both are generated from here and CI fails if",
    "the generated files are stale (R-013).",
    "",
    "Tokens are semantic, never literal: state.recorded, not green. The point of the",
    "token is that it survives a change of mind about the colour.",
    "",
    "text.fg-terminal is the same in both themes on purpose: the terminal ground is dark",
    "in either, so text on it is light in either. Using text.fg there instead put dark",
    "text on a dark ground in the light theme — invisible, and only in replay."
  ],
  "surface": {
    "bg":           { "light": "#faf9f7", "dark": "#131316" },
    "bg-raised":    { "light": "#ffffff", "dark": "#1c1c20" },
    "bg-terminal":  { "light": "#1a1a1e", "dark": "#0e0e11" },
    "border":       { "light": "#e3e0da", "dark": "#2b2b31" },
    "border-strong":{ "light": "#c9c5bd", "dark": "#3d3d45" }
  },
  "text": {
    "fg":         { "light": "#1b1b1f", "dark": "#eceaeb" },
    "fg-muted":   { "light": "#5c5a5f", "dark": "#a3a1a6" },
    "fg-faint":   { "light": "#8a878d", "dark": "#6e6c72" },
    "fg-inverse": { "light": "#faf9f7", "dark": "#131316" },
    "fg-terminal":  { "light": "#eceaeb", "dark": "#eceaeb" }
  },
  "state": {
    "recorded":     { "light": "#1f6f4a", "dark": "#4cb98a" },
    "unrecorded":   { "light": "#a8541b", "dark": "#e08a4a" },
    "observed":     { "light": "#7a4cc4", "dark": "#b18ae8" },
    "reconnecting": { "light": "#8a6a12", "dark": "#d4ad3c" },
    "ended":        { "light": "#5c5a5f", "dark": "#a3a1a6" },
    "refused":      { "light": "#a32b2b", "dark": "#e8706e" }
  },
  "terminal": {
    "black":          { "light": "#1a1a1e", "dark": "#0e0e11" },
    "red":            { "light": "#c0473f", "dark": "#e8706e" },
    "green":          { "light": "#4a9e6a", "dark": "#7fd39b" },
    "yellow":         { "light": "#c19a3c", "dark": "#e0c46a" },
    "blue":           { "light": "#4a7fc1", "dark": "#7fb0e8" },
    "magenta":        { "light": "#a06ac1", "dark": "#c79ae8" },
    "cyan":           { "light": "#3f9ea6", "dark": "#6fd0d8" },
    "white":          { "light": "#d6d3ce", "dark": "#c9c6c1" },
    "bright-black":   { "light": "#5c5a5f", "dark": "#4a4a52" },
    "bright-red":     { "light": "#e0665c", "dark": "#f28f8c" },
    "bright-green":   { "light": "#6fc48c", "dark": "#9ae8b3" },
    "bright-yellow":  { "light": "#e0bb5c", "dark": "#f0da8c" },
    "bright-blue":    { "light": "#6f9ee0", "dark": "#9fc8f0" },
    "bright-magenta": { "light": "#bf8ce0", "dark": "#dcb5f0" },
    "bright-cyan":    { "light": "#5fbfc7", "dark": "#8fe4ea" },
    "bright-white":   { "light": "#f2f0ed", "dark": "#eceaeb" },
    "cursor":         { "light": "#eceaeb", "dark": "#eceaeb" },
    "selection":      { "light": "#3d5a80", "dark": "#33507a" }
  }
}
