  "cards": [
    {
      "dot": "rose",
      "title": "Trust, stated plainly",
      "items": [
        "The gateway reads every keystroke and every byte of output, and can inject its own",
        "That is not a gap - it is the direct cost of recording and mid-session revocation",
        "The agent is trusted with its own device only: it cannot open a session or address another device"
      ]
    },
    {
      "dot": "cyan",
      "title": "What is checked, and when",
      "items": [
        "Authentication at the door: a key, or an identity provider with an algorithm allow-list",
        "Authorization per action and per device, before any device is woken",
        "Re-checked every 30 s for the life of the session, so a withdrawn grant closes it"
      ]
    },
    {
      "dot": "amber",
      "title": "Two gates, and one is slower to change",
      "items": [
        "Authorize takes a target: ports, paths and argv are gateway policy",
        "The device keeps its own list: the gateway's compromise is total",
        "A gateway grant changes in 30 s; the device list is a fleet push"
      ]
    }
  ]
