[0.017, "o", "\r\n\u001b[2m# The device publishes an allow-list of complete argvs. This one is on it:\u001b[0m\r\n"]
[1.307, "o", "\u001b[1;31m$\u001b[0m ssh treadmill-4821@gateway /usr/bin/uptime\r\n"]
