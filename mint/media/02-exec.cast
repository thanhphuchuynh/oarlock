[0.006, "o", "\r\r\n"]
[1.409, "o", "\r\n\u001b[2m# This one is not. The device refuses it; the gateway never gets to decide.\u001b[0m\r\n"]
[1.303, "o", "\u001b[1;31m$\u001b[0m ssh treadmill-4821@gateway /bin/cat /etc/passwd\r\n"]
[0.846, "o", "\r\r\n[oarlock] not_authorized: agent: that command is not allowed on this device: /bin/cat /etc/passwd\r\r\n\r\r\n"]
